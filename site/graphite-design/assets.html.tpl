    <figure class="asset g-box">{{fig:cast-props}}<figcaption><b><span class="lang-zh">物件贴纸</span><span class="lang-en">Object stickers</span></b><a href="../../skills/graphite-design/templates/figures/cast-props.svg" download>cast-props.svg</a></figcaption></figure>
    <figure class="asset g-box">{{fig:mark-kit}}<figcaption><b><span class="lang-zh">批注工具</span><span class="lang-en">Annotation kit</span></b><a href="../../skills/graphite-design/templates/figures/mark-kit.svg" download>mark-kit.svg</a></figcaption></figure>
    <figure class="asset g-box">{{fig:mark-video-safe}}<figcaption><b><span class="lang-zh">短视频安全区</span><span class="lang-en">Video safe areas</span></b><a href="../../skills/graphite-design/templates/figures/mark-video-safe.svg" download>mark-video-safe.svg</a></figcaption></figure>
    <figure class="asset g-box">{{fig:cinema-storyboard}}<figcaption><b><span class="lang-zh">分镜模板</span><span class="lang-en">Storyboard template</span></b><a href="../../skills/graphite-design/templates/figures/cinema-storyboard.svg" download>cinema-storyboard.svg</a></figcaption></figure>
