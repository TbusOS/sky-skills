<script src="../../skills/graphite-design/assets/sketch.js"></script>
<script src="../../skills/graphite-design/assets/props.js"></script>
<script src="../../skills/graphite-design/assets/taste.js"></script>
<script src="../../skills/graphite-design/assets/player.js"></script>
<script>
/* taste lab: the same learner as scripts/taste.mjs, log kept in localStorage */
(function () {
  'use strict';
  var KEY = 'graphite-taste-log', zh = function () { return document.documentElement.getAttribute('data-lang') !== 'en'; };
  var ev; try { ev = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { ev = []; }
  function save() { try { localStorage.setItem(KEY, JSON.stringify(ev)); } catch (e) { /* private mode */ } }
  function sample(k, tag) {
    var S = Sketch.create({ seed: 5, id: 'lab' + tag, taste: { rough: k.rough, hatchGap: k.hatchGap } });
    Props.robot(S, 64, 236, 0.66, { pose: 'wave' });
    Props.node(S, 140, 30, 180, 66, { zh: '缓存', en: 'cache' }, { pen: 'orange', size: k.labelSize });
    S.rect(146, 128, 76, 66, { r: 10, fill: 'blue' });
    S.circle(268, 166, 36, { fill: 'green' });
    S.path([[146, 220], [200, 210], [260, 224], [318, 212]], {});
    var f = Sketch.filters({ grain: k.grain, warp: k.warp }).replace(/id="g-pencil"/, 'id="g-pencil-' + tag + '"').replace(/id="g-tooth"/, 'id="g-tooth-' + tag + '"');
    var st = '--g-lw:' + k.lineWeight + ';--g-hz-o:' + k.hatchOpacity + ';--g-wash-o:' + k.washOpacity;
    return '<svg viewBox="0 0 340 250" class="gfig" style="' + st + '" aria-hidden="true"><defs>' + f + '</defs><g filter="url(#g-pencil-' + tag + ')">' + S.art() + '</g><g>' + S.labels() + '</g></svg>';
  }
  var q;
  function render() {
    var t = Taste.estimate(ev);
    q = Taste.ab(ev);
    var lab = zh() ? q.label.zh : q.label.en;
    document.getElementById('taste-q').textContent = (zh() ? '这一题只改「' + lab + '」:你更喜欢哪张?' : 'Only "' + lab + '" differs. Which do you prefer?');
    document.getElementById('taste-say').placeholder = zh() ? '说一句,比如:线太抖了,颜色太多' : 'say something, e.g. too wobbly, too many colours';
    document.getElementById('taste-a').innerHTML = sample(q.a, 'a') + '<span>A · ' + q.values[0] + '</span>';
    document.getElementById('taste-b').innerHTML = sample(q.b, 'b') + '<span>B · ' + q.values[1] + '</span>';
    var out = '';
    for (var key in Taste.KNOBS) {
      var K = Taste.KNOBS[key], v = t.knobs[key], pct = function (x) { return ((x - K.min) / (K.max - K.min) * 100).toFixed(1) + '%'; };
      out += '<div class="knob"><span>' + (zh() ? K.zh : K.en) + '</span><span class="bar"><i style="left:' + pct(K.def) + '"></i><b style="left:' + pct(v) + '"></b></span><output>' + v + '</output></div>';
    }
    document.getElementById('taste-knobs').innerHTML = out;
    var lines = ev.slice(-6).reverse().map(function (e) {
      var what = e.kind === 'pick' ? Object.keys(e.knobs)[0] + ' → ' + e.knobs[Object.keys(e.knobs)[0]] : e.kind === 'say' ? '「' + e.note + '」' : e.kind;
      return e.ts.slice(11, 19) + '  ' + e.kind + '  ' + what;
    });
    document.getElementById('taste-log').textContent = lines.length ? lines.join('\n') : (zh() ? '还没有记录。选一张试试。' : 'Nothing yet. Pick one.');
  }
  function pick(win) {
    var w = q.values[win], l = q.values[1 - win];
    ev.push(Object.assign({ ts: new Date().toISOString() }, Taste.pick(q.knob, w, l, 'lab')));
    save(); render();
  }
  document.getElementById('taste-a').addEventListener('click', function () { pick(0); });
  document.getElementById('taste-b').addEventListener('click', function () { pick(1); });
  function say() {
    var inp = document.getElementById('taste-say'), e = Taste.say(inp.value), heard = document.getElementById('taste-heard');
    if (!Object.keys(e.dir).length && !Object.keys(e.cat).length) { heard.textContent = zh() ? '这句里没有认得的说法,没记。' : 'No words it knows in that; nothing recorded.'; return; }
    ev.push(Object.assign({ ts: new Date().toISOString() }, e)); save();
    heard.textContent = (zh() ? '听到:' : 'Heard: ') + e.hits.join(', ') + ' → ' + Object.keys(e.dir).map(function (k) { return k + (e.dir[k] > 0 ? ' ↑' : ' ↓'); }).join(', ');
    inp.value = ''; render();
  }
  document.getElementById('taste-say-go').addEventListener('click', say);
  document.getElementById('taste-say').addEventListener('keydown', function (e) { if (e.key === 'Enter') say(); });
  document.getElementById('taste-export').addEventListener('click', function () {
    var blob = new Blob([ev.map(function (e) { return JSON.stringify(e); }).join('\n') + '\n'], { type: 'application/x-ndjson' });
    var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'graphite-taste.jsonl'; a.click();
  });
  document.getElementById('taste-reset').addEventListener('click', function () { ev = []; save(); render(); document.getElementById('taste-heard').textContent = ''; });
  document.querySelectorAll('[data-lang-toggle]').forEach(function (b) { b.addEventListener('click', function () { setTimeout(render, 0); }); });
  render();
})();
</script>
